[Unit]
Description=Hooya administrator authentication
After=network.target

[Service]
Type=simple
User=hooya-admin
Group=hooya-admin
ExecStart=/usr/bin/node /usr/local/lib/hooya-admin/admin-server.mjs
Environment=HOOYA_ADMIN_CREDENTIALS=/etc/hooya-admin/credentials.json
Environment=HOOYA_ADMIN_UI=/var/lib/hooya-source/admin-current
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
MemoryMax=192M
UMask=0077

[Install]
WantedBy=multi-user.target
